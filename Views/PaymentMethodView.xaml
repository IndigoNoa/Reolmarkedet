<Window x:Class="Reolmarkedet.Views.PaymentMethodView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="PaymentMethodView" Height="500" Width="850">

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="10,0"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#D8C5B9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Banner -->
		<Border Grid.Row="0" Background="#3A5A2A" Height="50">
			<TextBlock Text="Reolmarkedet" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
		</Border>

		<!-- Indhold -->
		<Grid Grid.Row="1" Margin="40,20,40,20">
			<TextBlock Text="Betaling" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

			<!-- Beløb til betaling (bundet til AmountToPay) -->
			<Border Background="#EFE1C7" BorderBrush="#3A5A2A" BorderThickness="1" CornerRadius="8"
                    Padding="20,15" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0">
				<Grid>
					<TextBlock Text="Beløb til betaling" FontSize="16" Foreground="#3A5A2A"
                               HorizontalAlignment="Left"/>
					<TextBlock Text="{Binding AmountToPay, StringFormat={}{0}.-}" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
				</Grid>
			</Border>

			<TextBlock Text="Vælg betalingsmetode for at færdiggøre transaktion" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0"/>


		<!--- Kontant og Mobilepay knapper-->
			<Button Content="Kontant betaling" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Kontant"
        Background="White" BorderBrush="#3A5A2A" Foreground="#3A5A2A" FontWeight="Bold"
        Width="180" Height="60"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,210,0,0"/>

			<Button Content="MobilePay" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="MobilePay"
        Background="#5A6FE0" Foreground="White" FontWeight="Bold"
        Width="180" Height="60"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="410,210,0,0"/>

			<!-- Tilbage (bundet til ReturnToCheckoutCommand) -->
			<Button Content="Tilbage" Command="{Binding ReturnToCheckoutCommand}"
                    Background="#3A5A2A" Foreground="White" FontWeight="Bold"
                    Width="130" Height="34"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
		</Grid>
	</Grid>
</Window>