<Window x:Class="Reolmarkedet.Views.MonthlyReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="MonthlyReportView" Height="500" Width="850">

	<Window.DataContext>
		<vm:VM_MonthlyReport/>
	</Window.DataContext>

	<Window.Resources>
		<vm:RenterReportStatusConverter x:Key="ReportStatusConverter"/>
		<Style TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="10,0"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#D8C5B9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Banner -->
		<Border Grid.Row="0" Background="#3A5A2A" Height="50">
			<TextBlock Text="Reolmarkedet" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
		</Border>

		<!-- Indhold -->
		<Grid Grid.Row="1" Margin="40,20,40,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="Månedsopgørelse" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

			<!-- Lejerliste (bundet til AllRenters) -->
			<DataGrid Grid.Row="1" ItemsSource="{Binding AllRenters}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderBrush="#3A5A2A" BorderThickness="1"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Lejer" Binding="{Binding RenterName}" Width="*"/>
					<DataGridTemplateColumn Header="Status" Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding RenterID, Converter={StaticResource ReportStatusConverter}}" Margin="10,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="" Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button Content="Opret" Command="{Binding DataContext.CreateReportCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#3A5A2A" Foreground="White" FontWeight="Bold"
                                        Width="90" Height="28"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Home (bundet til HomeCommand) -->
			<Button Grid.Row="2" Content="Home" Command="{Binding HomeCommand}"
                    Width="150" Height="34" Background="#3A5A2A" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Right" Margin="0,15,0,0"/>
		</Grid>
	</Grid>
</Window>