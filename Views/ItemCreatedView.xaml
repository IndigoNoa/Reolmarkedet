<Window x:Class="Reolmarkedet.Views.ItemCreatedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="ItemCreatedView" Height="450" Width="800">

	<Window.DataContext>
		<vm:VM_AddItem/>
	</Window.DataContext>

	<Window.Resources>
		<!-- Afrundede knapper -->
		<Style TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#D8C5B9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Banner -->
		<Border Grid.Row="0" Background="#3A5A2A" Height="50">
			<TextBlock Text="Reolmarkedet" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
		</Border>

		<!-- Indhold -->
		<Grid Grid.Row="1">
			<TextBlock Text="Vare oprettet" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,30,0,0"/>

			<!-- Grøn cirkel med flueben -->
			<Border Width="70" Height="70" CornerRadius="35" Background="#3A5A2A"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,90,0,0">
				<TextBlock Text="✓" Foreground="White" FontSize="36"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>

			<!-- Varenummer, Reol og Lejer (bundet til ItemID, ShelfID, RenterName) -->
			<StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,95,0,0">
				<TextBlock FontSize="14">
                    <Run Text="Varenummer:" FontWeight="Bold"/>
                    <Run Text="{Binding ItemID}"/>
				</TextBlock>
				<TextBlock FontSize="14">
                    <Run Text="Reol:" FontWeight="Bold"/>
                    <Run Text="{Binding ShelfID}"/>
				</TextBlock>
				<TextBlock FontSize="14">
                    <Run Text="Lejer:" FontWeight="Bold"/>
                    <Run Text="{Binding RenterName}"/>
				</TextBlock>
			</StackPanel>

			<!-- Stregkode (midlertidigt en boks med tallet, biblioteket kommer senere) -->
			<Border Width="230" Height="80" Background="White" BorderBrush="#3A5A2A" BorderThickness="1"
                    CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,180,0,0">
				<TextBlock Text="{Binding Barcode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>

			<!-- Print label (bundet til PrintLabelCommand) -->
			<Button Content="Print label" Command="{Binding PrintLabelCommand}"
                    Width="150" Height="34" Background="White" BorderBrush="#3A5A2A"
                    Foreground="#3A5A2A" FontWeight="Bold"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,30"/>

			<!-- Home (bundet til HomeCommand) -->
			<Button Content="Home" Command="{Binding HomeCommand}"
                    Width="150" Height="34" Background="#3A5A2A" BorderBrush="#3A5A2A"
                    Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,30"/>
		</Grid>
	</Grid>
</Window>