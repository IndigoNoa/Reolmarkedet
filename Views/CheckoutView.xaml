<Window x:Class="Reolmarkedet.Views.CheckoutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="CheckoutView" Height="500" Width="850">

	<Window.DataContext>
		<vm:VM_Checkout/>
	</Window.DataContext>

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="10,0"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#D8C5B9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Banner -->
		<Border Grid.Row="0" Background="#3A5A2A" Height="50">
			<TextBlock Text="Reolmarkedet" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
		</Border>

		<!-- Indhold -->
		<Grid Grid.Row="1" Margin="40,20,40,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="Kasse" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<!-- Scan / indtast (bundet til ScanBarcodeCommand) -->
			<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
				<TextBox Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged}"
				 Width="150" Height="30" Margin="0,0,10,0"/>
				<Button Content="Scan stregkode" Command="{Binding ScanBarcodeCommand}"
				 Background="#E7EEDD" BorderBrush="#3A5A2A" Foreground="#3A5A2A" FontWeight="Bold"
			     Height="40" Padding="10,0" Margin="0,0,10,0"/>
				<Button Content="Indtast varenummer"
                        Background="#E7EEDD" BorderBrush="#3A5A2A" Foreground="#3A5A2A" FontWeight="Bold"
                        Height="40" Padding="10,0"/>
			</StackPanel>

			<!-- Kurv (bundet til ScannedCheckoutItems) -->
			<DataGrid Grid.Row="2" ItemsSource="{Binding ScannedCheckoutItems}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderBrush="#3A5A2A" BorderThickness="1"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="35">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Varenavn/ID" Binding="{Binding ItemName}" Width="*"/>
					<DataGridTextColumn Header="Reolnummer" Binding="{Binding ShelfID}" Width="*"/>
					<DataGridTextColumn Header="Varenummer/stregkode" Binding="{Binding Barcode}" Width="*"/>
					<DataGridTextColumn Header="Pris" Binding="{Binding ItemPrice}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- At betale (bundet til AmountToPay) -->
			<Border Grid.Row="3" Background="#EFE1C7" BorderBrush="#3A5A2A" BorderThickness="1"
			 CornerRadius="8" Padding="15,10" Margin="0,15,0,15"
			Width="240" HorizontalAlignment="Right">
			<Grid>
			<TextBlock Text="At betale:" FontSize="18" HorizontalAlignment="Left"/>
			<TextBlock Text="{Binding AmountToPay, StringFormat={}{0}.-}" FontSize="18" FontWeight="Bold"
            HorizontalAlignment="Right"/>
			</Grid>
			</Border>

			<!-- Betaling (bundet til GoToPaymentMethodCommand) -->
			<Button Grid.Row="4" Content="Betaling" Command="{Binding GoToPaymentMethodCommand}"
                    Width="160" Height="34" Background="#3A5A2A" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Right"/>
		</Grid>
	</Grid>
</Window>