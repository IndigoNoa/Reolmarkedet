<UserControl x:Class="Reolmarkedet.Views.ShelfDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="Montserrat, Segoe UI">

    <UserControl.Resources>

        <!-- Label over felterne -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Afrundet inputfelt (kun visning) -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A5A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Samme felt, men med kursiv tekst -->
        <Style x:Key="ItalicTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <!-- Rund luk-knap (×) -->
        <Style x:Key="CloseCircleButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D2D2D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grøn afrundet Luk-knap -->
        <Style x:Key="GreenRoundedButton" TargetType="Button">
            <Setter Property="Width" Value="95"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#3A5A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C4620"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- Mørklægger Reoloversigten bag popup'en -->
        <Grid Background="#66000000"/>

        <!-- Popup: højden tilpasser sig indholdet -->
        <Border Width="410"
                Background="White"
                CornerRadius="22"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid Margin="24,20,24,18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- OVERSKRIFT + X -->
                <Grid Grid.Row="0" Margin="0,0,0,6">

                    <TextBlock Text="{Binding ShelfTitle, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="#222222"/>

                    <Button Content="×"
                            Style="{StaticResource CloseCircleButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding CloseCommand}"/>

                </Grid>

                <!-- STATUS -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ShelfStatus, Mode=OneWay}"
                             Style="{StaticResource ItalicTextBox}"/>
                </StackPanel>

                <!-- LEJER -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="Lejer" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding RenterName, Mode=OneWay}"
                             Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>

                <!-- TELEFON + EMAIL -->
                <Grid Grid.Row="3" Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <TextBlock Text="Tlf." Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RenterPhone, Mode=OneWay}"
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RenterEmail, Mode=OneWay}"
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                </Grid>

                <!-- DATOER -->
                <Grid Grid.Row="4" Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <TextBlock Text="Udlejet fra d." Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RentalStartDate, Mode=OneWay}"
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <TextBlock Text="Opsigelsesdato" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CancellationDate, Mode=OneWay}"
                                 Style="{StaticResource ItalicTextBox}"/>
                    </StackPanel>

                </Grid>

                <!-- LUK -->
                <Button Grid.Row="5"
                        Content="Luk"
                        Style="{StaticResource GreenRoundedButton}"
                        HorizontalAlignment="Center"
                        Command="{Binding CloseCommand}"/>

            </Grid>

        </Border>

    </Grid>
</UserControl>