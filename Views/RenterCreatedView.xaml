<Window x:Class="Reolmarkedet.Views.RenterCreatedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="RenterCreatedView" Height="450" Width="800">

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="10,0"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#D8C5B9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#3A5A2A" Height="50">
			<TextBlock Text="Reolmarkedet" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
		</Border>

		<Grid Grid.Row="1" Margin="40,30,40,30">
			<TextBlock Text="Lejeaftale oprettet" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,70,0,0">
				<Border Width="60" Height="60" CornerRadius="30" Background="#3A5A2A">
					<TextBlock Text="✓" Foreground="White" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
				<StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
					<TextBlock FontStyle="Italic"><Run Text="Lejer: " FontWeight="Bold"/><Run Text="{Binding RenterName}"/></TextBlock>
					<TextBlock FontStyle="Italic"><Run Text="Reol(er): " FontWeight="Bold"/><Run Text="{Binding ShelfIDsText, Mode=OneWay}"/></TextBlock>
					<TextBlock FontStyle="Italic"><Run Text="Periode: " FontWeight="Bold"/><Run Text="{Binding AddRenterDate, StringFormat=MMMM yyyy}"/></TextBlock>
				</StackPanel>
			</StackPanel>

			<!-- Home (bundet til HomeCommand) -->
			<Button Content="Home" Command="{Binding HomeCommand}"
                    Width="150" Height="34" Background="#3A5A2A" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
		</Grid>
	</Grid>
</Window>