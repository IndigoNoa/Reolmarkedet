<Window x:Class="Reolmarkedet.Views.AddRenterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="ReolMarked" Height="500" Width="800"
        Background="#D8C5B9">

    <Window.DataContext>
        <vm:ViewModel_AddRenter />
    </Window.DataContext>

    <Grid>
        <!-- Title Section -->
        <Border Background="#3A5A2A" Height="50">
            <TextBlock Text="ReolMarked" 
                       Foreground="White" 
                       FontSize="24" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Input Fields -->
        <StackPanel Margin="20" VerticalAlignment="Top">
            <Label Content="Navn:" Foreground="#3A5A2A"/>
            <TextBox Text="{Binding Name}" Height="30" Margin="0,5" Padding="5" Background="White" BorderBrush="#3A5A2A" BorderThickness="2"/>

            <Label Content="Adresse:" Foreground="#3A5A2A"/>
            <TextBox Text="{Binding Address}" Height="30" Margin="0,5" Padding="5" Background="White" BorderBrush="#3A5A2A" BorderThickness="2"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Label Content="TLF:" Foreground="#3A5A2A" Width="50"/>
                <TextBox Text="{Binding Phone}" Height="30" Margin="0,0,10,0" Padding="5" Background="White" BorderBrush="#3A5A2A" BorderThickness="2" Width="200"/>
        
                <Label Content="E-mail:" Foreground="#3A5A2A" Width="70"/>
                <TextBox Text="{Binding Email}" Height="30" Padding="5" Background="White" BorderBrush="#3A5A2A" BorderThickness="2" Width="200"/>
            </StackPanel>

            <Label Content="Ønsket antal reoler:" Foreground="#3A5A2A"/>
            <ComboBox SelectedValue="{Binding DesiredShelfCount}" Margin="0,5" Height="30" 
                      BorderBrush="#3A5A2A" BorderThickness="2">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="7" />
                <ComboBoxItem Content="8" />
                <ComboBoxItem Content="9" />
                <ComboBoxItem Content="10" />
            </ComboBox>

            <!-- "Næste" Button in the Right Corner -->
            <Button Content="Næste" Command="{Binding AddRenterCommand}" 
                    Background="#3A5A2A" Foreground="White" 
                    Margin="0,20,0,0" Height="40" 
                    FontSize="16" Width="100" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>