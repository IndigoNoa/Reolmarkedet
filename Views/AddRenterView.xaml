<Window x:Class="Reolmarkedet.Views.AddRenterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Reolmarkedet.ViewModels"
        Title="AddRenterView" Height="500" Width="850">

	<Window.DataContext>
		<vm:VM_AddRenter/>
	</Window.DataContext>

	<Window.Resources>
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#3A5A2A"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
							<ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="10,0"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#D8C5B9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#3A5A2A" Height="50">
			<TextBlock Text="Reolmarkedet" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
		</Border>

		<Grid Grid.Row="1" Margin="40,20,40,20">
			<TextBlock Text="Opret ny lejer" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

			<TextBlock Text="Navn" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,60,0,0"/>
			<TextBox Text="{Binding RenterName, UpdateSourceTrigger=PropertyChanged}"
                     Width="760" Height="34"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,80,0,0"/>

			<TextBlock Text="Adresse" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,130,0,0"/>
			<TextBox Text="{Binding RenterAddress, UpdateSourceTrigger=PropertyChanged}"
                     Width="760" Height="34"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,150,0,0"/>

			<TextBlock Text="Tlf." FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,200,0,0"/>
			<TextBox Text="{Binding RenterPhone, UpdateSourceTrigger=PropertyChanged}"
                     Width="360" Height="34"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,220,0,0"/>

			<TextBlock Text="E-mail" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="400,200,0,0"/>
			<TextBox Text="{Binding RenterEmail, UpdateSourceTrigger=PropertyChanged}"
                     Width="360" Height="34"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="400,220,0,0"/>

			<TextBlock Text="Ønsket antal reoler" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,270,0,0"/>
			<ComboBox SelectedValue="{Binding RenterShelvesAmount, UpdateSourceTrigger=PropertyChanged}"
			 SelectedValuePath="Tag"
			 Width="200" Height="34"
			 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,290,0,0">
				<ComboBoxItem Content="1" Tag="1"/>
				<ComboBoxItem Content="2" Tag="2"/>
				<ComboBoxItem Content="3" Tag="3"/>
				<ComboBoxItem Content="4" Tag="4"/>
				<ComboBoxItem Content="5" Tag="5"/>
			</ComboBox>

			<!-- Næste (bundet til NextCommand) -->
			<Button Content="Næste" Command="{Binding NextCommand}"
                    Width="150" Height="34" Background="#3A5A2A" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
		</Grid>
	</Grid>
</Window>