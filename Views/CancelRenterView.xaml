<Window x:Class="Reolmarkedet.Views.CancelRenterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reolmarkedet.Views"
        mc:Ignorable="d"
        Title="CancelRenterView" Height="450" Width="800">
    <Grid>

     <TextBlock Text="Opsig Lejer" FontSize="24" FontWeight="Bold" Margin="20"/>
        
        <TextBox x:Name="SearchBox" Width="300" Height="30" Margin="20,60,0,0" 
                 PlaceholderText="Søg lejer..."/>
        <Button Content="Søg" Width="100" Height="30" 
                Margin="340,60,0,0" Command="{Binding SearchCommand}"/>
        
        <ListBox x:Name="RenterListBox" ItemsSource="{Binding RenterList}" 
                 DisplayMemberPath="Name" 
                 Margin="20,100,20,0" Height="200" />
        
        <Button Content="Opsig valgt lejer" Width="150" Height="40" 
                Margin="20,320,0,0" 
                Command="{Binding CancelSelectedRenterCommand}"/>
        <Button Content="Opsig reol" Width="100" Height="40" 
                Margin="190,320,0,0" 
                Command="{Binding CancelSelectedReolCommand}"/>
        <Button Content="Tilbage" Width="80" Height="40" 
                Margin="305,320,0,0" 
                Command="{Binding CloseCommand}"/>
    </Grid>
</Window>
